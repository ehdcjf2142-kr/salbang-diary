---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import { siteConfig } from '../site.config';
import ogImageSrc from '../assets/images/og-thumbnail.png';
import salbangLogo from '../assets/images/salbang-logo.png';

interface Props {
	title: string;
	description?: string;
	/** 홈 히어로 사용 시 상단 제목은 히어로에 두고, 헤더는 축소 */
	compactHeader?: boolean;
}

const { title, description = siteConfig.tagline, compactHeader = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title === siteConfig.siteTitle ? title : `${title} · ${siteConfig.siteTitle}`;

const og = await getImage({
	src: ogImageSrc,
	width: 1200,
	height: 630,
	format: 'jpg',
	quality: 82,
});
const siteOrigin = Astro.site ?? new URL('http://localhost:4321');
const ogImageUrl = new URL(og.src, siteOrigin).href;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="살방살방 안동 강변 토요 모임" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<slot name="hero" />
		<div class="wrap">
			<header class:list={['site-header', compactHeader && 'site-header--compact']}>
				{
					compactHeader ? (
						<p class="site-brand-compact">
							<a href={base}>{siteConfig.siteTitle}</a>
						</p>
					) : (
						<h1 class="site-title">
							<a href={base} style="color: inherit; text-decoration: none;">{siteConfig.siteTitle}</a>
						</h1>
					)
				}
				{!compactHeader && <p class="site-tagline">{siteConfig.tagline}</p>}
				<nav class="nav-row" aria-label="주요 링크">
					<a href={base}>기록 목록</a>
					<a href={`${base}about/`}>이 모임은</a>
				</nav>
			</header>
			<slot />
			<footer class="site-footer">
				<div class="site-footer__inner">
					<Image
						class="site-footer__logo"
						src={salbangLogo}
						alt="살방살방"
						widths={[52, 104]}
						sizes="52px"
						loading="lazy"
						decoding="async"
					/>
					<p class="site-footer__text">
						살방살방 — 안동 강변 토요 모임 기록. 링크만 알면 누구나 볼 수 있어요. 지금은 임시로 열어 둔 페이지입니다.
					</p>
				</div>
			</footer>
		</div>
	</body>
</html>
