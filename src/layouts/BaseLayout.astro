---
import '../styles/global.css';
import { siteConfig } from '../site.config';

interface Props {
	title: string;
	description?: string;
}

const { title, description = siteConfig.tagline } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title === siteConfig.siteTitle ? title : `${title} · ${siteConfig.siteTitle}`;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="wrap">
			<header class="site-header">
				<h1 class="site-title">
					<a href={base} style="color: inherit; text-decoration: none;">{siteConfig.siteTitle}</a>
				</h1>
				<p class="site-tagline">{siteConfig.tagline}</p>
				<nav class="nav-row" aria-label="주요 링크">
					<a href={base}>기록 목록</a>
					<a href={`${base}about/`}>이 모임은</a>
				</nav>
			</header>
			<slot />
			<footer class="site-footer">
				살방살방 — 안동 강변 토요 모임 기록. 링크만 알면 누구나 볼 수 있어요. 지금은 임시로 열어 둔 페이지입니다.
			</footer>
		</div>
	</body>
</html>
