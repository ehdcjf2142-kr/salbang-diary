---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import OpenChatCallout from '../components/OpenChatCallout.astro';
import { siteConfig } from '../site.config';
import dividerImg from '../assets/images/section-divider.png';
import salbangLogo from '../assets/images/salbang-logo.png';
---

<BaseLayout title="이 모임은" description={siteConfig.tagline} compactHeader navActive="about">
	<HomeHero slot="hero" />

	<article class="post about-page">
		<h1 class="about-page__title">이 모임은</h1>
		<div class="body">
			<p class="temp-notice" role="status">{siteConfig.tempSiteNotice}</p>
			<p>
				<strong>{siteConfig.siteTitle}</strong>은 안동 강변에서 매주 토요일에 모여 걷고 뛰는 모임이에요. 페이스는
				각자에게 맡기고, 마지막에는 함께 사진 한 장 남기는 걸 목표로 해요.
			</p>
			<div class="notice-block">
				<Image
					class="notice-block__logo"
					src={salbangLogo}
					alt="살방살방 그래픽 시안"
					widths={[100, 200]}
					sizes="100px"
					loading="lazy"
					decoding="async"
				/>
				<p class="tshirt-note">{siteConfig.tshirtNote}</p>
			</div>
			<p>기록은 <a href={`${import.meta.env.BASE_URL}records/`}>기록 목록</a>에, 실시간 이야기는 카카오톡 오픈채팅에서 나눠요.</p>
		</div>
	</article>

	<Image
		class="section-divider-img"
		src={dividerImg}
		alt=""
		widths={[120, 180]}
		sizes="120px"
		loading="lazy"
		decoding="async"
	/>

	<OpenChatCallout />
</BaseLayout>
