---
import { siteConfig } from '../site.config';

const base = import.meta.env.BASE_URL;
const { mode, url, buttonLabel, roomName, searchKeyword, steps } = siteConfig.openChat;
---

<section class="join-section" aria-labelledby="join-heading">
	<header class="join-section__header">
		<h2 id="join-heading" class="join-section__title">함께하고 싶다면</h2>
		<p class="join-section__lead">
			실시간 소통은 카카오톡 오픈채팅에서 해요. 모임 후기·사진은 이 사이트
			<a href={`${base}records/`}>기록 목록</a>에 천천히 올라갑니다.
		</p>
	</header>

	{
		mode === 'link' && url ? (
			<p class="join-section__alt">
				<a class="button" href={url} target="_blank" rel="noopener noreferrer">
					{buttonLabel}
				</a>
				<span class="join-section__alt-note">또는 아래 순서대로 검색해 주세요.</span>
			</p>
		) : null
	}

	<div class="join-section__card">
		<p class="join-section__card-label">오픈채팅 찾는 방법</p>
		<ol class="join-steps">
			{steps.map((step, i) => (
				<li>
					<span class="join-steps__num" aria-hidden="true">
						{i + 1}
					</span>
					<span class="join-steps__text">{step}</span>
				</li>
			))}
		</ol>
		<p class="join-section__room">
			찾을 때 이름: <strong>{roomName}</strong>
			<span class="join-section__hint"> (검색어 예: {searchKeyword})</span>
		</p>
	</div>
</section>
